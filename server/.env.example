# ============================
# Solo NEET SS — Server Config
# ============================
# Copy this file to .env and fill in values.
# Only JWT_SECRET and FRONTEND_URL are required in production.
# All other variables are optional — features auto-detect at startup.

# --- Required (production) ---
JWT_SECRET=your-secret-key-here-change-me
FRONTEND_URL=http://localhost:5173

# --- Server ---
PORT=3002
NODE_ENV=development

# --- Google OAuth 2.0 (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3002/api/auth/google/callback

# --- Razorpay Payments (optional) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- AI / LLM (optional) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# OLLAMA_MODEL=llama3:70b

# --- Firebase Push Notifications (optional) ---
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- PubMed NCBI (optional — higher rate limits) ---
# NCBI_API_KEY=

# --- Logging ---
# LOG_LEVEL=info
